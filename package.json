{
  "name": "crm-eco",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "shared"
  ],
  "scripts": {
    "audit:crm-visibility": "node scripts/audit-crm-visibility.mjs",
    "audit:crm-vocabulary": "node scripts/audit-crm-vocabulary.mjs",
    "check:conflicts": "node scripts/check-merge-conflicts.js",
    "build": "npm run check:conflicts && vite build",
    "build:shared": "npm run check:conflicts && npm run build --workspace=@crm-eco/shared",
    "build:crm": "npm run check:conflicts && npm run build:shared && npm run build --workspace=@crm-eco/crm",
    "build:admin": "npm run check:conflicts && npm run build:shared && npm run build --workspace=@crm-eco/admin",
    "build:portal": "npm run check:conflicts && npm run build --workspace=@crm-eco/portal",
    "build:advisor-portal": "npm run check:conflicts && npm run build:shared && npm run build --workspace=@crm-eco/advisor-portal",
    "build:website": "npm run check:conflicts && npm run build --workspace=@crm-eco/website",
    "build:doublehelixhub": "npm run check:conflicts && npm run build --workspace=@crm-eco/doublehelixhub",
    "build:cashpay": "npm run check:conflicts && npm run build --workspace=@crm-eco/cashpay",
    "build:all": "npm run check:conflicts && turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:generate-types": "node scripts/gen-db-types.mjs",
    "db:generate-types:check": "node scripts/gen-db-types.mjs --check",
    "workspace:hygiene": "sh scripts/workspace-hygiene.sh",
    "db:audit:records": "node scripts/run-db-audit-records.mjs",
    "db:audit:records:strict": "node scripts/run-db-audit-records.mjs --strict",
    "db:health": "node scripts/run-db-health.mjs",
    "verify:coverage-fields": "node scripts/verify-coverage-field-parity.mjs",
    "verify:hs-canonical-drift": "psql \"$PIFH_SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f scripts/sql/assert-healthshare-canonical-drift.sql",
    "pifh:gate": "node scripts/pifh-deploy-gate.mjs",
    "resend:setup": "node scripts/resend-domain-setup.mjs",
    "migrate:zoho-contacts": "tsx scripts/migrate-zoho-contacts.ts",
    "typecheck": "turbo typecheck",
    "typecheck:crm": "npm run typecheck --workspace=@crm-eco/crm",
    "typecheck:admin": "npm run typecheck --workspace=@crm-eco/admin",
    "lint:crm": "npm run lint --workspace=@crm-eco/crm",
    "precheck:crm": "npm run typecheck:crm && npm run lint:crm",
    "smoke-test": "node scripts/smoke-test.mjs",
    "db:test-connection": "node scripts/test-db-connection.mjs",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-query": "^5.90.10",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.344.0",
    "openai": "^4.104.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.66.0",
    "react-is": "^19.0.0",
    "react-router-dom": "^6.30.2",
    "recharts": "^3.4.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "docx": "^9.5.3",
    "dotenv": "^17.2.3",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "i18next": "^25.8.0",
    "i18next-http-backend": "^3.0.2",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postgres": "^3.4.8",
    "prettier": "^3.2.4",
    "react-i18next": "^16.5.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18",
    "terser": "^5.44.1",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.3.3",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2"
}
