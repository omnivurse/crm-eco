# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server Environment
OPENAI_API_KEY=sk-your-openai-key
# Optional model overrides for the CRM record AI affordances
# (defaults to gpt-4o-mini for both):
# OPENAI_MODEL_FIELD_SUGGEST=gpt-4o-mini
# OPENAI_MODEL_EMAIL_DRAFT=gpt-4o-mini
# Optional model for nightly habit coaching tips (aggregates only, no PHI):
# OPENAI_MODEL_HABITS=gpt-4o-mini
# Soft daily token ceiling per org for habits AI tips (default 200000):
# HABITS_AI_ORG_DAILY_TOKEN_BUDGET=200000
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
N8N_BASE_URL=https://your-n8n.domain.com
N8N_API_KEY=your-n8n-api-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
CRM_BASE_URL=https://api.your-crm.com/v1
CRM_API_KEY=your-crm-api-key
EMBED_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4o-mini

# Frontend AI Features
VITE_GEMINI_API_KEY=your-gemini-api-key

# Monorepo PIN gate — all Next.js apps use LeadGenQuotePinGate (always on).
# Override the shared PIN in production via Vercel env on each project:
# NEXT_PUBLIC_SITE_PIN=your-pin

# CRM inactivity session lock (password screen). Off by default for tester access.
# NEXT_PUBLIC_ENABLE_SESSION_LOCK=true

# Development
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Email Service (Resend) — PIFH production defaults
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@payitforwardhealth.com
RESEND_FROM_NAME=Pay It Forward Health
FROM_EMAIL=noreply@payitforwardhealth.com
INFO_EMAIL=info@payitforwardhealth.com
SUPPORT_EMAIL=support@payitforwardhealth.com

# Cron Jobs
# Required for all cron-triggered routes (email queue, sequences, automation, scheduler)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Enrollment completion (gold-standard finalize: vault + charge month 1 +
# membership pending + billing schedule + portal invite). Off by default.
# Set to 'true' only after payment provider + tokenized payment step are ready.
# ENROLLMENT_COMPLETION_ENABLED=true

# Security
JWT_SECRET=your-jwt-secret
# 64-character hex string for encrypting OAuth tokens at rest
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# GoTo Connect Integration
GOTO_ACCESS_TOKEN=your-goto-personal-access-token
GOTO_WEBHOOK_URL=https://your-domain.com/api/goto-connect/webhooks
PUBLIC_URL=https://your-domain.com