# Member Portal — environment variables
# Copy to apps/portal/.env.local for local dev.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs
NEXT_PUBLIC_PORTAL_URL=https://members.doublehelixhub.com
NEXT_PUBLIC_CRM_URL=https://crm.doublehelixhub.com
NEXT_PUBLIC_ADMIN_URL=https://admin.doublehelixhub.com

# Public enrollment software (the WEBSITE). The member portal is MANAGE-ONLY —
# its "Enroll Now" links point here, NOT to the portal's own /enroll. External
# absolute URL.
NEXT_PUBLIC_ENROLLMENT_URL=https://www.doublehelixhub.com/enroll

# Authorize.Net Accept.js (public — safe in browser; add when keys arrive)
# From Authorize.Net Merchant Interface → Account → Security Settings → API Credentials
# and Accept.js / Public Client Key. Use sandbox keys until go-live.
NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID=
NEXT_PUBLIC_AUTHORIZE_NET_CLIENT_KEY=
NEXT_PUBLIC_AUTHORIZE_NET_ENVIRONMENT=sandbox

# Optional
ENROLL_DRAFT_SECRET=
RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Health Cost Labs cash-price search (server-only — never NEXT_PUBLIC_)
# Local: also in repo-root .env.local. Production: Vercel env on the portal project.
HCL_API_BASE_URL=https://healthcostlabsapp-hclapi.azurewebsites.net
HCL_SECRET_KEY=
HCL_MSA_ALLOWLIST=[{"stateName":"Alabama","msaName":"Birmingham - Huntsville - Gadsden","specialty":"Hospital cash prices"}]

# Enrollment completion (finalize adapter). Off by default — see packages/lib
# billing/PAYMENTS.md. When true, self-serve submit uses finalizeEnrollment /
# finalize_member_enrollment_tx instead of inline memberships.insert.
# ENROLLMENT_COMPLETION_ENABLED=true
