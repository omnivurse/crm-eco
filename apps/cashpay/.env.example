# Public / server env for apps/cashpay. Never commit secrets.
# Copy values into the Vercel project `cashpay` (oi-agent), not the portal.

NEXT_PUBLIC_SITE_URL=https://cashpay.doublehelixhub.com
NEXT_PUBLIC_BRAND_NAME=Double Helix Hub
NEXT_PUBLIC_BRAND_PRODUCT=Cash Pay
NEXT_PUBLIC_BRAND_SIGNAL=#d97706

HCL_API_BASE_URL=https://healthcostlabsapp-hclapi.azurewebsites.net
HCL_SECRET_KEY=
HCL_MSA_ALLOWLIST=[{"stateName":"Alabama","msaName":"Birmingham - Huntsville - Gadsden","specialty":"Hospital cash prices"}]
# Optional overrides for exact HCL specialty strings (hospital, Pharmacy / RX, imaging, lab)
# HCL_SPECIALTIES=[{"id":"hospital","label":"Hospital & facility","hclName":"Hospital cash prices","codeHint":"CPT / HCPCS"},{"id":"pharmacy","label":"Pharmacy / RX","hclName":"Pharmacy","codeHint":"NDC"}]

# Lead capture (same internal org as doublehelixhub.com)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SQL warehouse is ops-only — do NOT set these on the Vercel cashpay project.
# HCL_SQL_SERVER=
# HCL_SQL_PORT=1433
# HCL_SQL_USER=
# HCL_SQL_PASSWORD=
