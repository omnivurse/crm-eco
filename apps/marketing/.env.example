# Marketing site (apps/marketing) — doublehelix.com
# All values are optional in dev; set them on Vercel for production.

# Email forwarding for the /contact form (Resend)
# Get a key from https://resend.com/api-keys (Sending → restrict to your domain)
RESEND_API_KEY=
# `from` must be on a verified domain in Resend (https://resend.com/domains)
SALES_FROM_EMAIL="Double Helix <noreply@doublehelix.com>"
SALES_INBOX_EMAIL=sales@doublehelix.com

# Public URLs surfaced in the UI
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.doublehelix.com
NEXT_PUBLIC_CRM_APP_URL=https://crm.doublehelix.com

# Optional analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
