{
  "installCommand": "cd ../.. && rm -rf node_modules/.package-lock.json && npm install --legacy-peer-deps",
  "buildCommand": "cd ../.. && npm run build:crm",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "crm.payitforwardhealth.com" }],
      "destination": "https://crm.doublehelixhub.com/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/email/process-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/comms/cron",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/sequences/process",
      "schedule": "* * * * *"
    }
  ]
}
