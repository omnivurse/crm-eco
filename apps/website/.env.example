# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for the anon prospect enrollment API routes (api/enroll/*): all writes
# go through the service-role client, never the public anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Portal URL (for Sign In links)
NEXT_PUBLIC_PORTAL_URL=https://members.doublehelixhub.com

# Advisor Portal URL
NEXT_PUBLIC_ADVISOR_PORTAL_URL=https://advisors.doublehelixhub.com

# Anon prospect enrollment (api/enroll/*)
# ENROLL_DRAFT_SECRET signs the draft cookie that is the anon prospect's identity/
# ownership token for the public enrollment flow (no login). Falls back to
# ENCRYPTION_KEY if unset. RECAPTCHA_SECRET gates the final submit (bypassed when
# unset, for non-prod). NEXT_PUBLIC_RECAPTCHA_SITE_KEY is the matching client key.
ENROLL_DRAFT_SECRET=
RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Flag-gated, default OFF. Leave unset for the safe default (submitted enrollments
# stay 'submitted' for manual triage; engine-computed price is never persisted).
#   ENROLLMENT_APPROVAL_ENABLED=true  → auto-route matching submits to pending_review
#   RATE_ENGINE_WRITE_ENABLED=true    → persist engine-computed base_monthly_cost
#   ELIGIBILITY_ENFORCE=true          → hold blocking-ineligible submits for review
ENROLLMENT_APPROVAL_ENABLED=
RATE_ENGINE_WRITE_ENABLED=
ELIGIBILITY_ENFORCE=
