{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@crm-eco/lib": [
        "../../packages/lib/src"
      ],
      "@crm-eco/lib/*": [
        "../../packages/lib/src/*"
      ],
      "@crm-eco/ui": [
        "../../packages/ui/src"
      ],
      "@crm-eco/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@crm-eco/shared": [
        "../../shared/src"
      ],
      "@crm-eco/shared/*": [
        "../../shared/src/*"
      ]
    },
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
